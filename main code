        private void btneq_Click(object sender, RoutedEventArgs e)
        {
            if (fnopt.Text == "*")
            {
                int num = Convert.ToInt16(txt1.Text);
                int num2= Convert.ToInt16(txt2.Text);
                int rl = num * num2;
                rslt.Text = Convert.ToString(rl);
            }
            else if (fnopt.Text == "+")
            {
                int num = Convert.ToInt16(txt1.Text);
                int num2 = Convert.ToInt16(txt2.Text);
                int rl = num + num2;
                rslt.Text = Convert.ToString(rl);
            }
            else if(fnopt.Text == "-")
            {
                int num = Convert.ToInt16(txt1.Text);
                int num2 = Convert.ToInt16(txt2.Text);
                int rl = num - num2;
                rslt.Text = Convert.ToString(rl);
            }
            else
            {
                int num = Convert.ToInt16(txt1.Text);
                int num2 = Convert.ToInt16(txt2.Text);
                int rl = num / num2;
                rslt.Text = Convert.ToString(rl);
            }
        }

