<Window x:Class="Calciwbtn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calciwbtn"
        mc:Ignorable="d"
        Title="GG's Calculator" Background="LightYellow"  Height="500" Width="350">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Name="txtfirst" FontWeight="DemiBold" Margin="5,5,5,5" Text="First Number :"></TextBlock>
            <TextBox Name="txt1" Width="200" Height="20" FontWeight="Bold" Margin="20,5,5,5" FontFamily="Agency FB" Foreground="Black"></TextBox>
        </StackPanel>
        <TextBox Name="fnopt" Width="20" Margin="55,0,0,0" Text=""></TextBox>
            <StackPanel Orientation="Horizontal">
            <TextBlock Name="textsecond" FontWeight="DemiBold" Margin="5,5,5,5" Text="Second Number :"></TextBlock>
            <TextBox Name="txt2" Width="200" Height="20" FontFamily="Agency FB" FontWeight="Bold" Margin="3,5,5,5"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Name="result" Text="Result : " FontWeight="DemiBold" Margin="5,5,5,5"></TextBlock>
            <TextBox Name="rslt" Width="200" Height="20" FontFamily="Agency FB" FontWeight="Bold" Margin="55,5,5,5"></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,30,0,0" HorizontalAlignment="Center">
            <Button Content="7" Name="btn7" Click="btn7_Click" Width="50" Height="50" Margin="5,10,5,5"></Button>
            <Button Content="8" Name="btn8" Click="btn8_Click" Width="50" Height="50" Margin="5,10,5,5"></Button>
            <Button Content="9" Name="btn9" Click="btn9_Click" Width="50" Height="50" Margin="5,10,5,5"></Button>
            <Button Content="*" Name="btnmult" Click="btnmult_Click" Width="50" Height="50" Margin="5,10,5,5"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="4" Name="btn4" Click="btn4_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="5" Name="btn5" Click="btn5_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="6" Name="btn6" Click="btn6_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="+" Name="btnadd" Click="btnadd_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="1" Name="btn1" Click="btn1_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="2" Name="btn2" Click="btn2_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="3" Name="btn3" Click="btn3_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="-" Name="btnsub" Click="btnsub_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="0" Name="btn0" Click="btn0_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="/" Name="btndiv" Click="btndiv_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="=" Name="btneq" Click="btneq_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
            <Button Content="c" Name="btnclr" Click="btnclr_Click" Width="50" Height="50" Margin="5,5,5,5"></Button>
        </StackPanel>
    </StackPanel>
</Window>
